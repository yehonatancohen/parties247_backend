# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development        # development | production
PORT=3001
DEBUG=false

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD_HASH=          # bcrypt hash of the admin password

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/parties247

# ── Canonical / SEO ──────────────────────────────────────────────────────────
CANONICAL_BASE_URL=https://your-frontend.vercel.app

# IndexNow (optional — submit URLs to search engines on publish)
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY_LOCATION=       # e.g. https://your-frontend.vercel.app/<key>.txt

# Next.js ISR revalidation (optional)
REVALIDATE_ENDPOINT=         # e.g. https://your-frontend.vercel.app/api/revalidate
REVALIDATE_SECRET=

# ── GoOut scraper VM ─────────────────────────────────────────────────────────
# Shared secret — must match SERVICE_TOKEN in goout-scraper/.env
SERVICE_TOKEN=change-me-to-a-long-random-string
